    // which meant the real deployed backend had no reachable AI service at
    // all. Pointing this at the football_performance_analysis deployment on
    // FastAPI Cloud instead. docker-compose.yml still overrides this via
    // AiService__BaseUrl for local/dev runs, so this only affects the real
    // deployment.
    "BaseUrl": "https://jogo-ai.fastapicloud.dev",
    // /analyze-by-url returns immediately and processes in the background —
